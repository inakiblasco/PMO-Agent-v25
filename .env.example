# Copy this file to .env and fill only the values required by your runtime.
# Do not put secrets in this file. .env is ignored by Git.

# mock: local tests, foundry: Foundry model/host (service adapters may still be mock)
PMO_RUNTIME=mock
LOG_LEVEL=INFO
# Set to /app/skills in the hosted container. Empty uses the source-tree default.
PMO_SKILLS_DIR=

# Local JSONL execution traces. Trace files may contain user and tool data.
PMO_TRACE_ENABLED=true
PMO_TRACE_DIR=log
PMO_TRACE_MAX_CHARS=20000

# Azure AI Foundry / model. Required for PMO_RUNTIME=foundry.
FOUNDRY_PROJECT_ENDPOINT=https://<project>.services.ai.azure.com
AZURE_AI_MODEL_DEPLOYMENT_NAME=<chat-model-deployment>
# default: standard Azure credential chain; cli: az; azd: azd user; managed_identity: hosted identity
AZURE_CREDENTIAL_MODE=default

# Azure Cosmos DB. Required when persistent proposal, audit, or message state is enabled.
COSMOS_ENDPOINT=https://<account>.documents.azure.com:443/
COSMOS_DATABASE_NAME=fde-pmo-agent
COSMOS_PROPOSALS_CONTAINER=pmo-proposals
COSMOS_AUDIT_CONTAINER=pmo-audit-events
COSMOS_MESSAGE_DELIVERY_CONTAINER=pmo-message-delivery

# Real service endpoints. Required only after the corresponding adapter is implemented.
# ADO read-only access through a Foundry toolbox. Mock remains the default.
# ADO_MCP_SERVER_URL is reserved; the implemented transport uses ADO_TOOLBOX_ENDPOINT.
ADO_MODE=mock
# toolbox enables approval-bound Gateway writes; toolbox_readonly blocks writes.
ADO_WRITE_TOOLBOX_ENDPOINT=
# https://aifoundry-techenablement-fde-hackathon-dev-jpe-001.services.ai.azure.com/api/projects/FDE-hackathon/toolboxes/pmo-agent-tools/versions/3/mcp?api-version=v1
ADO_TOOLBOX_ENDPOINT=
# Existing v2: https://aifoundry-techenablement-fde-hackathon-dev-jpe-001.services.ai.azure.com/api/projects/FDE-hackathon/toolboxes/pmo-agent-tools/versions/2/mcp?api-version=v1
ADO_PROJECT=
ADO_QUERY_ID=
ADO_DUE_DATE_FIELD=
# Comma-separated confirmed terminal states for this ADO project/process.
ADO_COMPLETED_STATES=
ADO_SERVER_LABEL=ado
WORKIQ_MCP_SERVER_URL=https://<workiq-mcp-host>/mcp
WORKIQ_MODE=disabled
WORKIQ_TOOLBOX_ENDPOINT=
# https://aifoundry-techenablement-fde-hackathon-dev-jpe-001.services.ai.azure.com/api/projects/FDE-hackathon/toolboxes/pmo-workiq-tools/versions/1/mcp?api-version=v1
M365_MESSAGE_GATEWAY_URL=https://<message-gateway>/api

# Optional observability connection string.
APPLICATIONINSIGHTS_CONNECTION_STRING=
